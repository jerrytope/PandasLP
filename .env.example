NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/placeholder
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Rebuilt Property Law Agent (docs/property_agent_plans/). "true" = router + sub-agents. Read by the browser (starter menu) and the server.
NEXT_PUBLIC_PROPERTY_AGENT_V2=false
# LOCAL TESTING ONLY: scripts/property-agent-chat.ts (npm run property:chat) sends the property agent to Groq and saves to SQLite.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# Law library search: "off" = keywords only. Unset = meaning search with gte-small (downloaded once).
# LAW_VECTOR_SEARCH=off
# TRANSFORMERS_CACHE_DIR=/tmp/pandaslp-models
# Web search of trusted Nigerian law sites for laws not in the library (lib/property/webSearch.ts). Unset = off.
# TAVILY_API_KEY=tvly-...
# Who can open /manageai and change how the agents draft documents (comma-separated). Separate from ADMIN_EMAILS.
AI_MANAGER_EMAILS=
